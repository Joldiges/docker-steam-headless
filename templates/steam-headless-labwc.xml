<?xml version="1.0"?>
<Container version="2">
  <Name>steam-headless-labwc</Name>
  <Repository>docker.io/jamesoldiges/steam-headless:labwc-wayland-nvidia</Repository>
  <Registry>https://hub.docker.com/r/jamesoldiges/steam-headless</Registry>
  <Network>host</Network>
  <Privileged>true</Privileged>
  <Support>https://github.com/Joldiges/docker-steam-headless/issues</Support>
  <Project>https://github.com/Joldiges/docker-steam-headless/tree/labwc-wayland-nvidia</Project>
  <Overview>Steam Headless with labwc Wayland, Sunshine, Xwayland, Bolt OSRS launcher, virtual display, and virtual input support.</Overview>
  <Category>GameServers:</Category>
  <WebUI>https://[IP]:[PORT:47990]</WebUI>
  <Config Name="Home directory" Target="/home/default" Default="/mnt/user/appdata/steam-headless-labwc/home" Mode="rw" Description="Persistent Steam, Bolt, labwc, and Sunshine configuration." Type="Path" Display="advanced" Required="true" Mask="false"/>
  <Config Name="Games directory" Target="/mnt/games" Default="/mnt/user/appdata/steam-headless-labwc/games" Mode="rw" Description="Persistent Steam library and game data." Type="Path" Display="advanced" Required="true" Mask="false"/>
  <Config Name="PUID" Target="PUID" Default="99" Mode="" Description="Container user ID. Unraid appdata normally uses nobody (99)." Type="Variable" Display="advanced" Required="true" Mask="false"/>
  <Config Name="PGID" Target="PGID" Default="100" Mode="" Description="Container group ID. Unraid users normally use 100." Type="Variable" Display="advanced" Required="true" Mask="false"/>
  <Config Name="Sunshine Web UI" Target="47990" Default="47990" Mode="tcp" Description="Sunshine configuration UI. Host networking is enabled." Type="Port" Display="advanced" Required="true" Mask="false"/>
  <Config Name="USER" Target="USER" Default="default" Mode="" Description="Desktop username." Type="Variable" Display="advanced" Required="true" Mask="false"/>
  <Config Name="USER_PASSWORD" Target="USER_PASSWORD" Default="" Mode="" Description="Password for the desktop user and SSH. Set this in the template." Type="Variable" Display="advanced" Required="true" Mask="false"/>
  <Config Name="Enable Steam" Target="ENABLE_STEAM" Default="true" Mode="" Description="Start Steam automatically." Type="Variable" Display="advanced" Required="true" Mask="false"/>
  <Config Name="Enable Sunshine" Target="ENABLE_SUNSHINE" Default="true" Mode="" Description="Start Sunshine automatically." Type="Variable" Display="advanced" Required="true" Mask="false"/>
  <Config Name="Display width" Target="DISPLAY_SIZEW" Default="2560" Mode="" Description="Virtual display width." Type="Variable" Display="advanced" Required="true" Mask="false"/>
  <Config Name="Display height" Target="DISPLAY_SIZEH" Default="1600" Mode="" Description="Virtual display height." Type="Variable" Display="advanced" Required="true" Mask="false"/>
  <Config Name="Display refresh" Target="DISPLAY_REFRESH" Default="120" Mode="" Description="Default virtual display refresh rate." Type="Variable" Display="advanced" Required="true" Mask="false"/>
  <Config Name="Display scale" Target="DISPLAY_SCALE" Default="1.25" Mode="" Description="Default labwc scale factor." Type="Variable" Display="advanced" Required="true" Mask="false"/>
  <Config Name="Web UI mode" Target="WEB_UI_MODE" Default="vnc" Mode="" Description="Use vnc for raw Wayland VNC debugging on VNC_PORT, or none for Moonlight only." Type="Variable" Display="advanced" Required="true" Mask="false">vnc</Config>
  <Config Name="VNC port" Target="VNC_PORT" Default="5901" Mode="" Description="Raw VNC port, used when Web UI mode is vnc. 5900 is avoided because Unraid commonly uses it for another VNC service. Do not expose it to the Internet." Type="Variable" Display="advanced" Required="true" Mask="false"/>
  <Config Name="VNC password" Target="VNC_PASSWORD" Default="" Mode="" Description="VNC password. If empty, the desktop USER_PASSWORD is used." Type="Variable" Display="advanced" Required="false" Mask="true"/>
  <Config Name="Sunshine CSRF origins" Target="SUNSHINE_CSRF_ALLOWED_ORIGINS" Default="" Mode="" Description="Trusted Sunshine Web UI origins, comma-separated." Type="Variable" Display="advanced" Required="false" Mask="false">https://192.168.0.226:47990,https://192.168.0.202:47990,https://192.168.0.240:47990</Config>
  <Device Name="uinput" Target="/dev/uinput" Default="/dev/uinput" Mode="rw" Description="Virtual mouse, keyboard, and gamepad input." Type="Device" Display="advanced" Required="true" Mask="false"/>
  <Device Name="tty0" Target="/dev/tty0" Default="/dev/tty0" Mode="rw" Description="Seat/input device access." Type="Device" Display="advanced" Required="true" Mask="false"/>
  <Device Name="console" Target="/dev/console" Default="/dev/console" Mode="rw" Description="Seat/input device access." Type="Device" Display="advanced" Required="true" Mask="false"/>
</Container>
